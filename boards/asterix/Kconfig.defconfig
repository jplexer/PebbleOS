# The recovery firmware shares the 1 MiB flash bank with the normal
# firmware and is linked in the upper half.
config FW_FLASH_SIZE
    default 0x80000 if FIRMWARE_AREA_RECOVERY
    # 1 MiB of flash less the 32 KiB bootloader the image is linked past.
    default 0xf8000

# The bootloader starts the watchdog, which cannot be stopped.
config WATCHDOG
    default y

if FUEL_GAUGE_THEVENIN

config FUEL_GAUGE_THEVENIN_RC_MILLIOHM
    default 561

config FUEL_GAUGE_THEVENIN_RC_TAU_MS
    default 98169

endif
